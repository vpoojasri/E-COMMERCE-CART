# ===================================================================
# E-COMMERCE ENGINE WITH AUTOMATED ORDER TRACKING - .env.example
# Copy or set these environment variables in your shell / IDE before
# running the application in MySQL mode, or use default H2 MySQL-mode
# fallback for immediate zero-config college lab execution.
# ===================================================================

# Database Configuration (MySQL 8.0+)
# For real MySQL server:
# DB_DRIVER=com.mysql.cj.jdbc.Driver
# DB_URL=jdbc:mysql://localhost:3306/ecommerce_tracking_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# DB_USERNAME=ecommerce_user
# DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# HIBERNATE_DIALECT=org.hibernate.dialect.MySQLDialect

# Initial Administrator Account Bootstrap (Safe Setup Process)
# Only created if no user with ADMIN role exists in the database
ADMIN_INITIAL_EMAIL=admin@ecommerce.edu
ADMIN_INITIAL_PASSWORD=Admin@12345!ChangeMe
ADMIN_INITIAL_NAME=System Administrator

# File Upload Settings
UPLOAD_DIR=./uploads/products
MAX_UPLOAD_SIZE_BYTES=5242880

# Automated Order Tracking Simulation Engine
# Disabled by default in normal use as required. Can be enabled via env var or Admin UI toggle.
TRACKING_AUTOMATION_ENABLED=false
TRACKING_AUTOMATION_INTERVAL_SECONDS=30

# Frontend CORS & Server Port
SERVER_PORT=8080
CORS_ALLOWED_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080/api

